{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Supersonique Studio SARL",
  "homepage_url": "https://github.com/mikecastrodemaria/Quill-Firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "quill-firefox@supersoniquestudio.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "images/icon-16px.png",
    "32": "images/icon-32px.png",
    "48": "images/icon-48px.png",
    "64": "images/icon-64px.png",
    "96": "images/icon-96px.png",
    "128": "images/icon-128px.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "images/icon-16px.png",
      "32": "images/icon-32px.png"
    }
  },
  "sidebar_action": {
    "default_title": "Quill",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": {
      "16": "images/icon-16px.png",
      "32": "images/icon-32px.png"
    },
    "open_at_install": false
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "__MSG_actionTitle__"
    }
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting", "menus"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://*.ai.cloud.ovh.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["<all_urls>"]
}
